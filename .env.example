# ── Jatelo Connect configuration ── copy to .env (deploy/setup.sh generates the secrets)

# Domains (DNS A records point to SERVER_PUBLIC_IP)
APP_DOMAIN=app.jateloconnect.com
API_DOMAIN=api.jateloconnect.com
PORTAL_DOMAIN=wifi.jateloconnect.com
ACME_EMAIL=eokoth2019@gmail.com

# Public addresses
SERVER_PUBLIC_IP=203.0.113.10
PUBLIC_API_URL=https://api.jateloconnect.com
PORTAL_URL=https://wifi.jateloconnect.com
DASHBOARD_URL=https://app.jateloconnect.com

# Database passwords (owner, API role, RADIUS role)
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
RADIUS_DB_PASSWORD=change-me

# Secrets: openssl rand -hex 32
JWT_SECRET=change-me-to-64-random-hex-chars
MASTER_KEY=change-me-to-64-random-hex-chars
# RADIUS shared secret used inside the WireGuard tunnel: openssl rand -hex 16
RADIUS_SECRET=change-me

# WireGuard hub (filled in by deploy/setup.sh)
WG_INTERFACE=wg0
WG_PORT=51820
WG_HUB_PUBLIC_KEY=
WG_MANAGE=true
RADIUS_HOST=10.88.0.1
# RADIUS_BACKUP_HOST=10.88.0.2

PORT=8080
TRIAL_DAYS=14
DEFAULT_CURRENCY=BIF
LOG_LEVEL=info
